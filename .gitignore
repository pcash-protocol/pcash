# Compiled output must never land beside its TypeScript source.
sdk/src/**/*.js
sdk/src/**/*.js.map
sdk/src/**/*.d.ts
sdk/src/**/*.d.ts.map
wallet/src/**/*.js
wallet/src/**/*.d.ts
marketplace/src/**/*.js
marketplace/src/**/*.d.ts
# ...but hand-written ambient declarations are source.
!sdk/src/bundler-env.d.ts
.git-pr/

# Reproducible parameter experiment output; keep calibration data separate from code review.
/bench/issuance/results/
/bench/issuance/*-results/

# Proof lab device results saved by `just bench`.
/bench/results/
