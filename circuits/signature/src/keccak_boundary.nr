// The vendored Keccak path dependency is outside `nargo test --workspace`.
// These known answers exercise its public API at the 136-byte rate boundary:
// padding bytes combine to 0x81 at 135 bytes and spill into a second block
// at 136 bytes.
//
// Expected digests come from @noble/hashes keccak_256. Input byte i is
// (i * 7 + 3) mod 256, so each case is reproducible without a fixture file.
use keccak256::keccak256;

fn probe_input<let N: u32>() -> [u8; N] {
    let mut input: [u8; N] = [0; N];
    for i in 0..N {
        input[i] = ((i * 7 + 3) % 256) as u8;
    }
    input
}

#[test]
fn test_keccak256_matches_known_answer_at_0_bytes() {
    let digest = keccak256(probe_input::<0>(), 0);
    assert_eq(
        digest,
        [
            0xc5, 0xd2, 0x46, 0x01, 0x86, 0xf7, 0x23, 0x3c, 0x92, 0x7e, 0x7d, 0xb2, 0xdc, 0xc7,
            0x03, 0xc0, 0xe5, 0x00, 0xb6, 0x53, 0xca, 0x82, 0x27, 0x3b, 0x7b, 0xfa, 0xd8, 0x04,
            0x5d, 0x85, 0xa4, 0x70,
        ],
        "keccak256 of 0 bytes must match the published digest",
    );
}

#[test]
fn test_keccak256_matches_known_answer_at_1_bytes() {
    let digest = keccak256(probe_input::<1>(), 1);
    assert_eq(
        digest,
        [
            0x69, 0xc3, 0x22, 0xe3, 0x24, 0x8a, 0x5d, 0xfc, 0x29, 0xd7, 0x3c, 0x5b, 0x05, 0x53,
            0xb0, 0x18, 0x5a, 0x35, 0xcd, 0x5b, 0xb6, 0x38, 0x67, 0x47, 0x51, 0x7e, 0xf7, 0xe5,
            0x3b, 0x15, 0xe2, 0x87,
        ],
        "keccak256 of 1 bytes must match the published digest",
    );
}

#[test]
fn test_keccak256_matches_known_answer_at_134_bytes() {
    let digest = keccak256(probe_input::<134>(), 134);
    assert_eq(
        digest,
        [
            0x0c, 0x00, 0xdd, 0xc2, 0x48, 0x28, 0x76, 0xf8, 0xfa, 0x8c, 0xc9, 0x1e, 0xd5, 0x5d,
            0xee, 0xdf, 0x61, 0x04, 0x98, 0x92, 0x96, 0x7f, 0x38, 0x35, 0x60, 0xfa, 0xf8, 0xa5,
            0x78, 0x7f, 0x86, 0xc5,
        ],
        "keccak256 of 134 bytes must match the published digest",
    );
}

#[test]
fn test_keccak256_matches_known_answer_at_135_bytes() {
    let digest = keccak256(probe_input::<135>(), 135);
    assert_eq(
        digest,
        [
            0x00, 0xef, 0x96, 0xaf, 0x9c, 0xf4, 0xb2, 0x4c, 0x7f, 0x26, 0x9d, 0x92, 0x22, 0x94,
            0x44, 0x4a, 0x19, 0x7d, 0x0a, 0x33, 0x63, 0x8c, 0x2e, 0x56, 0x63, 0x4c, 0x57, 0xe8,
            0x92, 0x10, 0x3a, 0x8f,
        ],
        "keccak256 of 135 bytes must match the published digest",
    );
}

#[test]
fn test_keccak256_matches_known_answer_at_136_bytes() {
    let digest = keccak256(probe_input::<136>(), 136);
    assert_eq(
        digest,
        [
            0x74, 0x20, 0x61, 0xbc, 0xad, 0x76, 0x7e, 0xd4, 0xc4, 0xf5, 0x88, 0x3b, 0x1d, 0xcb,
            0x1a, 0xad, 0x11, 0xaf, 0xdc, 0xc1, 0x40, 0xdc, 0x46, 0x9d, 0x95, 0x37, 0x59, 0xb1,
            0x27, 0xb9, 0xf9, 0xed,
        ],
        "keccak256 of 136 bytes must match the published digest",
    );
}

#[test]
fn test_keccak256_matches_known_answer_at_137_bytes() {
    let digest = keccak256(probe_input::<137>(), 137);
    assert_eq(
        digest,
        [
            0xe3, 0x37, 0x1f, 0x61, 0xe7, 0x70, 0xab, 0xf2, 0x54, 0xc3, 0x42, 0x39, 0xc3, 0xb0,
            0x09, 0x9a, 0xd9, 0x05, 0x94, 0x50, 0x74, 0x15, 0xbc, 0x81, 0xdd, 0x0a, 0x10, 0xb9,
            0x69, 0x2b, 0xbf, 0x2a,
