#[test]
fn test_keccak256_matches_known_answer_at_200_bytes() {
    let digest = keccak256(probe_input::<200>(), 200);
    assert_eq(
        digest,
        [
            0x66, 0xd2, 0xcd, 0xf3, 0xab, 0x4c, 0x5b, 0xd3, 0xc7, 0x5a, 0xdd, 0x9b, 0x60, 0xb1,
            0x4a, 0xc5, 0xb7, 0x78, 0x95, 0x34, 0xfa, 0x2d, 0xa3, 0xf3, 0x48, 0x85, 0x3b, 0x84,
            0x73, 0x59, 0xa3, 0xa0,
        ],
        "keccak256 of 200 bytes must match the published digest",
    );
}
