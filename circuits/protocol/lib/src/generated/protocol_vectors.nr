        0xe5, 0xec, 0xf3, 0xfa, 0x01,
    ];
    assert(
        carrier_context_hash(
            CARRIER_KIND_EVENT,
            0x0000000000000000000000006666666666666666666666666666666666666666,
            context,
        )
            == 0x1d2932f8bb65e9ab27ab516a0e9f8302ec535040b332a934e8e866c5134d7883,
    );
}

