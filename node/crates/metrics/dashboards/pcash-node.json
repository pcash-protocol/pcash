          "refId": "A"
        }
      ]
    },
    {
      "title": "Reorgs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(pcash_node_reorgs_total[5m])",
          "legendFormat": "reorgs/s",
          "refId": "A"
        }
      ]
