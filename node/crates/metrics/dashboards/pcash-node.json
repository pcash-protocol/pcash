  "panels": [
    {
      "title": "L1 lag (blocks)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "pcash_node_l1_lag_blocks",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Derived vs L1 head vs finalized",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "pcash_node_derived_l1_block", "legendFormat": "derived", "refId": "A" },
        { "expr": "pcash_node_l1_head", "legendFormat": "head", "refId": "B" },
        { "expr": "pcash_node_finalized_l1_block", "legendFormat": "finalized", "refId": "C" }
      ]
    },
    {
      "title": "Derive rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "rate(pcash_node_l1_blocks_derived_total[1m])",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Derive duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
