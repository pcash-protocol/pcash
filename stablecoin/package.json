{
  "name": "@pcash/stablecoin",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Issuer service for a deposit-mint stablecoin with a sender deny list.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../scripts/package/clean_dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@pcash/sdk": "^0.1.0",
    "viem": "^2.55.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist"
  ]
}
