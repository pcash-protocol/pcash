{
  "name": "@pcash/marketplace",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Headless PCASH marketplace contracts, flows, recovery, and verification.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./proofs": {
      "types": "./dist/proofs.d.ts",
      "default": "./dist/proofs.js"
    },
    "./tooling/*": {
      "types": "./dist/tooling/*.d.mts",
      "default": "./dist/tooling/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../scripts/package/clean_dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.{ts,mts}\"",
    "source-openings": "node src/tooling/sourceVerification.mts openings",
    "payment-router": "node src/tooling/paymentRouterOperator.mts",
    "prepack": "npm run build",
    "test:fast": "node test/fast.mjs"
  },
  "dependencies": {
    "@pcash/sdk": "^0.1.0",
    "viem": "^2.55.1"
  },
  "devDependencies": {
    "@pcash/wallet": "^0.1.0",
    "@pcash/test-support": "0.0.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  },
  "files": ["dist"]
}
