{
  "name": "@pcash/tokens",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Token claim templates: bearer claim links and eligibility drops.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./tooling/*": {
      "types": "./dist/tooling/*.d.mts",
      "default": "./dist/tooling/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/package/clean_dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/circuits/bundle.mjs exec -- node --test \"test/**/*.test.ts\"",
    "prepack": "npm run build",
    "test:fast": "node test/fast.mjs"
  },
  "dependencies": {
    "@pcash/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  },
  "files": ["dist"]
}
